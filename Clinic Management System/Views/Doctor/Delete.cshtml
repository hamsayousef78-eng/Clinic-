@model Clinic_Management_System.Models.Doctor

@{
    ViewData["Title"] = "Delete";
}

<h1 class="h3 fw-bold pb-2 mb-4 border-bottom">إدارة الاطباء</h1>

<div class="row g-4">

    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-primary text-white fw-bold"> حذف طبيب</div>
            <div class="card-body">
                <div class="mb-3">
                    اسم الطبيب
                    <span>@Model.Name</span>
                </div>
                <div class="mb-3">
                   رقم الهاتف
                    <span>@Model.Phone</span>
                </div>
                <div class="mb-3">
                 التخصص
                    <span>@Model.specialization.Name</span>
                </div>

                <form asp-controller="Doctor" asp-action="Delete" method="post">

                    <button type="submit" class="btn btn-primary w-100"> حذف</button>
                </form>
            </div>
        </div>
    </div>

</div>

       

