@using Clinic_Management_System.Models
@model Clinic_Management_System.Models.Patient


@{
    ViewData["Title"] = "Create";
}


<div class="card border-0 bg-light">

    <div class="card-header bg-white">
        <h5 class="fw-bold mb-0">
            سجل الكشوفات والحجوزات
        </h5>
    </div>

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th>التاريخ</th>
                        <th>الطبيب المعالج</th>
                        <th>التخصص</th>
                        <th>الحالة</th>
                        <th>التشخيص / الروشتة</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var details in Model.appointments)
                    {
                        <tr>
                            <td>@details.AppointmentDate</td>

                            <td class="fw-semibold">@details.doctor.Name</td>
                            <td>@details.doctor.specialization.Name</td>
                            <td>
                                <span class="badge bg-warning text-dark">
                                    @details.AppointmentStatus
                                </span>
                            </td>
                            <td class="text-muted">
                                @details.Notes
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

    </div>
</div>

       


