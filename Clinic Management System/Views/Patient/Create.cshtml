@model Clinic_Management_System.Models.Patient


@{
    ViewData["Title"] = "Create";
}
<h1 class="h3 fw-bold pb-2 mb-4 border-bottom">إدارة الاطباء</h1>

<div class="row g-8">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-primary text-white fw-bold">تسجيل مريض جديد</div>
            <div class="card-body">
                <form asp-controller="Patient" asp-action="Create" method="post" >
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">اسم المريض </label>
                        <input type="text" asp-for="Name" class="form-control">
                    </div>
                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label">رقم الهاتف </label>
                        <input type="tel" asp-for="Phone" class="form-control" >
                    </div>
                    <div class="mb-3">
                        <label asp-for="Age" class="form-label">العمر </label>
                        <input asp-for="Age" class="form-control">
                    </div>
                    <div class="mb-3">
                        <label asp-for="PatientGender" class="form-label">النوع </label>
                        <select asp-for="PatientGender" class="form-control">
                            <option value="">-- اختار النوع --</option>
                            @foreach (var gender in Enum.GetValues<Patient.Gender>())
                            {
                                <option value="@gender">@gender</option>
                            }
                        </select>
                    </div>
               
                    <button type="submit" class="btn btn-primary w-100">حفظ المريض الجديد</button>
                </form>
            </div>
        </div>
    </div>
</div>

       

